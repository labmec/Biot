SetFactory("OpenCASCADE");

// ============================================================
// Parameters
// ============================================================

L = 10.0;
lc = 8.0;

// ============================================================
// Main domain
// ============================================================

Box(1) = {0, 0, 0, L, L, L};

// ============================================================
// Fault surface
//
// Plane y = x
// Extends from x = 0 to x = 10 and z = 0 to z = 10
// ============================================================

Point(101) = {0,  0,  0,  lc};
Point(102) = {10, 10, 0,  lc};
Point(103) = {10, 10, 10, lc};
Point(104) = {0,  0,  10, lc};

Line(101) = {101, 102};
Line(102) = {102, 103};
Line(103) = {103, 104};
Line(104) = {104, 101};

Curve Loop(101) = {101, 102, 103, 104};
Plane Surface(101) = {101};

// ============================================================
// Split the volume with the fault
// ============================================================

BooleanFragments{
    Volume{1};
}{
    Surface{101};
};

// ============================================================
// Physical groups
// ============================================================

// Volumes
Physical Volume("Domain") = {1};

// Fault
Physical Surface("Fault") = {101};

// ============================================================
// Boundary surfaces
// ============================================================

Physical Surface("left")   = {5};
Physical Surface("right")  = {3};
Physical Surface("bottom") = {6};
Physical Surface("top")    = {4};
Physical Surface("front")  = {1};
Physical Surface("back")   = {2};

// ============================================================
// Mesh
// ============================================================

Mesh.Algorithm3D = 10;
Mesh.CharacteristicLengthMin = lc;
Mesh.CharacteristicLengthMax = lc;

Mesh 3;